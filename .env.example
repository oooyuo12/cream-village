# Gemini API key is required for AI route generation.
GEMINI_API_KEY=""

# Optional. Leave blank unless you want to force a specific Gemini model.
# Example: GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MODEL=""

# Optional. Used by the server.
PORT=3000

# Optional. Kept for compatibility with the UI template.
GOOGLE_MAPS_PLATFORM_KEY=""
